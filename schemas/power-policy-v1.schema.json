{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://preceptual.ai/kval/schemas/power-policy-v1.schema.json",
  "title": "Kval power policy payload",
  "description": "Signed thermal/battery/power/duty limits. Carried inside a signed document envelope of document_type kval-power-policy/v1.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "policy_id",
    "created_at",
    "expires_at",
    "thermal_ceiling_c",
    "thermal_resume_c",
    "max_sustained_watts",
    "allowed_nvpmodel_ids",
    "economy_nvpmodel_id",
    "performance_nvpmodel_id"
  ],
  "properties": {
    "policy_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "thermal_ceiling_c": {"type": "number", "minimum": 20, "maximum": 120},
    "thermal_resume_c": {"type": "number", "minimum": 0, "maximum": 120},
    "battery_floor_percent": {"type": "number", "minimum": 0, "maximum": 100},
    "max_sustained_watts": {"type": "number", "minimum": 1, "maximum": 200},
    "allowed_nvpmodel_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "economy_nvpmodel_id": {"type": "integer", "minimum": 0},
    "performance_nvpmodel_id": {"type": "integer", "minimum": 0},
    "min_telemetry_interval_seconds": {"type": "number", "minimum": 0.1, "maximum": 3600},
    "min_scan_interval_seconds": {"type": "number", "minimum": 0.1, "maximum": 3600},
    "max_inference_duty": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
