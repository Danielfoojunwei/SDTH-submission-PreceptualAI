{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://preceptual.ai/kval/schemas/spectrum-policy-v1.schema.json",
  "title": "Kval spectrum policy payload",
  "description": "Signed allowlist of approved bands for passive sensing. Carried inside a signed document envelope of document_type kval-spectrum-policy/v1.",
  "type": "object",
  "additionalProperties": true,
  "required": ["policy_id", "region", "created_at", "expires_at", "bands"],
  "properties": {
    "policy_id": {"type": "string", "minLength": 1},
    "region": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "passive_only": {"const": true},
    "max_scans_per_hour": {"type": "integer", "minimum": 1},
    "min_scan_interval_seconds": {"type": "number", "minimum": 0.05, "maximum": 3600},
    "bands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["band_id", "label", "freq_low_hz", "freq_high_hz", "max_resolution_bandwidth_hz"],
        "properties": {
          "band_id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "freq_low_hz": {"type": "integer", "minimum": 1},
          "freq_high_hz": {"type": "integer", "minimum": 1},
          "max_resolution_bandwidth_hz": {"type": "integer", "minimum": 1},
          "occupancy_baseline_percent": {"type": "number", "minimum": 0, "maximum": 100},
          "occupancy_alert_percent": {"type": "number", "minimum": 0, "maximum": 100},
          "noise_floor_baseline_dbm": {"type": "number", "minimum": -160, "maximum": 0},
          "comms_candidate": {"type": "boolean"}
        }
      }
    }
  }
}
