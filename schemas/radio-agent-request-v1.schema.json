{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://preceptual.ai/kval/schemas/radio-agent-request-v1.schema.json",
  "title": "Kval radio standards agent request",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "profile_id", "connection_uuid"],
      "properties": {
        "operation": {"const": "capabilities"},
        "profile_id": {"type": "string", "minLength": 1},
        "connection_uuid": {"type": "string", "format": "uuid"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "profile_id", "sdr_profile_id", "connection_uuid", "catalog_hash"],
      "properties": {
        "operation": {"const": "activate"},
        "profile_id": {"type": "string", "minLength": 1},
        "sdr_profile_id": {"type": "string", "minLength": 1},
        "connection_uuid": {"type": "string", "format": "uuid"},
        "catalog_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  ]
}
